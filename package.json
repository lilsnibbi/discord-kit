{
	"name": "@lilsnibbi/discord-kit",
	"version": "1.0.1",
	"description": "Client, command, event and pagination structures for discord.js bots on the Bun runtime.",
	"license": "MIT",
	"private": false,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"files": [
		"src"
	],
	"engines": {
		"bun": "^1.3.13"
	},
	"engineStrict": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lilsnibbi/discord-kit.git"
	},
	"scripts": {
		"typecheck": "bun tsc --noEmit",
		"lint": "bun biome check .",
		"test": "bun test",
		"check": "bun run typecheck && bun run test && bun run release:verify && bun run lint",
		"pretty": "bun biome format --write .",
		"audit": "bun audit --audit-level=high",
		"release:verify": "bun run scripts/verifyRelease.ts",
		"test:package": "bun test tests/package.test.ts"
	},
	"dependencies": {
		"@lilsnibbi/logger": "^1.1.0"
	},
	"peerDependencies": {
		"discord.js": "^14.26.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/bun": "1.4.2",
		"discord.js": "^14.26.4",
		"typescript": "7.0.2"
	}
}
